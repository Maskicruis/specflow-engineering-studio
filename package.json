{
  "name": "specflow-engineering-studio",
  "version": "0.6.1",
  "private": true,
  "description": "工程文档智能工作台：DeepSeek Harness Agent + MinerU 文档数据库 + RAG 原文定位与高亮",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "kb-platform": "cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.cjs",
    "runtime:prepare": "node scripts/prepare-runtime.cjs",
    "build:desktop": "npm run runtime:prepare && electron-builder --win nsis portable",
    "release:publish": "node scripts/publish-release.cjs",
    "serve": "node cli.js serve",
    "test": "node --test",
    "check": "node --check server.js && node --check cli.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/update-manager.cjs && node --check desktop/harness-runtime.cjs && node --check desktop/deepseek-balance.cjs && node --check scripts/prepare-runtime.cjs && node --check scripts/publish-release.cjs"
  },
  "author": "Maskicruis",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7",
    "https-proxy-agent": "7.0.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.specflow.engineering",
    "productName": "SpecFlow Engineering Studio",
    "artifactName": "SpecFlow-Engineering-Studio-v${version}-${arch}.${ext}",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "build/update-config.json",
      "build/app.ico",
      "src/**/*",
      "lib/**/*",
      "schemas/**/*",
      "ui.html",
      "server.js",
      "cli.js",
      "index.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/runtime",
        "to": "runtime",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "icon": "build/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "SpecFlow-Engineering-Studio-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "packElevateHelper": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpecFlow Engineering Studio",
      "installerIcon": "build/app.ico",
      "uninstallerIcon": "build/app.ico"
    },
    "portable": {
      "artifactName": "SpecFlow-Engineering-Studio-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
