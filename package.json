{
  "name": "specflow-engineering-studio",
  "version": "0.9.3",
  "private": true,
  "description": "工程设计工作台：项目目录、全过程检查、设计工具、独立 LLM、MinerU 文档数据库与 Harness 工作流",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "kb-platform": "cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.cjs",
    "runtime:prepare": "node scripts/prepare-runtime.cjs",
    "build:desktop": "npm run runtime:prepare && electron-builder --win nsis portable",
    "release:publish": "node scripts/publish-release.cjs",
    "serve": "node cli.js serve",
    "test": "node --test",
    "check": "node --check server.js && node --check cli.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/update-manager.cjs && node --check desktop/harness-connector.cjs && node --check desktop/deepseek-balance.cjs && node --check desktop/design-tools.cjs && node --check src/project-workspace.js && node --check src/spec-monitor.js && node --check src/query-planner.js && node --check src/citation-links.js && node --check ui-modules/road-slope-core.js && node --check ui-modules/workspace.js && node --check ui-tools/road-slope-window.js && node --check scripts/prepare-runtime.cjs && node --check scripts/publish-release.cjs"
  },
  "author": "Maskicruis",
  "dependencies": {
    "https-proxy-agent": "7.0.6"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.specflow.engineering",
    "productName": "SpecFlow Engineering Studio",
    "artifactName": "SpecFlow-Engineering-Studio-v${version}-${arch}.${ext}",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "build/update-config.json",
      "build/app.ico",
      "src/**/*",
      "ui-modules/**/*",
      "ui-tools/**/*",
      "lib/**/*",
      "schemas/**/*",
      "packages/dsh-specflow-knowledge/**/*",
      "packages/dsh-specflow-review-skill/**/*",
      "ui.html",
      "server.js",
      "cli.js",
      "index.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/runtime",
        "to": "runtime",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "icon": "build/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "SpecFlow-Engineering-Studio-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "packElevateHelper": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpecFlow Engineering Studio",
      "installerIcon": "build/app.ico",
      "uninstallerIcon": "build/app.ico"
    },
    "portable": {
      "artifactName": "SpecFlow-Engineering-Studio-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
